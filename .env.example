# Required in production. Local development uses a built-in fallback that must not be deployed.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Local default is file:data/healthtrack.db on this computer's disk.
# Vercel and Lambda discard the filesystem. Use a hosted libSQL URL there, for example libsql://your-database.turso.io.
# A file: URL is acceptable only when the host gives this process a persistent disk.
DATABASE_URL=file:data/healthtrack.db
DATABASE_AUTH_TOKEN=

# Set to 1 only when a trusted proxy sets X-Real-IP. Vercel does this when VERCEL=1.
# X-Forwarded-For is ignored because a caller can spoof it.
TRUST_PROXY=

# Optional. When both are set, verification and password-reset email can be sent.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. When both are set, Google sign-in is offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Coaching falls back to the deterministic engine when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
